# Base URL of the Agrisense backend API (no trailing slash).
# The "/api" prefix is added automatically by the API client.
# Interactive docs: ${VITE_API_BASE_URL}/api/docs
#
# Examples:
#   VITE_API_BASE_URL=https://agrisense.rw     (production)
#   VITE_API_BASE_URL=http://localhost:3001    (local backend)
#
# If left empty, the app falls back to a same-origin relative "/api" path.
VITE_API_BASE_URL=https://agrisense.rw
