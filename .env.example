# Base URL of the Agrisense backend API (no trailing slash).
# The "/api" prefix is added automatically by the API client.
#
# Set this to your environment's backend origin, e.g.:
#   VITE_API_BASE_URL=http://localhost:3001          (local development)
#   VITE_API_BASE_URL=https://api.your-domain.com    (production)
#
# If left empty, the app falls back to a same-origin relative "/api" path.
VITE_API_BASE_URL=
